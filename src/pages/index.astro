---
import MainLayout from "../layouts/MainLayout.astro";
import Hero from "../components/sections/Hero.astro";
// import TableContents from "../components/sections/TableContents.astro";

const lcPosts = Object.values(
  import.meta.glob("../pages/lcPosts/*.md", { eager: true }),
);

const wtbhPosts = Object.values(
  import.meta.glob("../pages/wtbhPosts/*.md", { eager: true }),
);

import SectionIntro from "../components/shared/SectionIntro.astro";
import Card from "../components/Card.astro";
import CTAcontent from "../components/shared/CTAcontent.astro";

// import Hero from "../components/sections/Hero.astro";
// import AddressKeyProblem from "../components/sections/AddressKeyProblem.astro";
// import DecorDivider from "../components/sections/DecorDivider.astro";
// import FindSolution from "../components/sections/FindSolution.astro";
// import CTA from "../components/sections/CTA.astro";
---

<MainLayout>
  <Hero />

  <div id="section-intro-container" class="uppercase">
    <SectionIntro
      bannerTitle="Laughing Coyote Dev"
      bannerParagraph="latests from a freelance site"
    />
  </div>
  <div
    id="expand-on-my-websites-card"
    class="bg- grid xl:grid-cols-3 lg:grid-cols-2 grid-cols-1 gap-x-1 pl-2 pb-5 mx-13.75"
  >
    {
      lcPosts.map((help: any) => (
        <Card
          pubDate={help.frontmatter.pubDate}
          postTitle={help.frontmatter.postTitle}
          image={help.frontmatter.image.url}
          alt={help.frontmatter.image.alt}
          url={help.url}
          testItem1={help.frontmatter.testItem1}
          language={help.frontmatter.language}
          backend={help.frontmatter.backend}
        />
      ))
    }
  </div>
  <div id="section-intro-container" class="uppercase">
    <SectionIntro
      bannerTitle=" Writing to Better Health"
      bannerParagraph="most recent by a nutrition blog"
    />
  </div>
  <!-- <h2>Writing to Better Health</h2> -->
  <div
    id="expand-on-my-websites-card"
    class="bg grid xl:grid-cols-3 lg:grid-cols-2 grid-cols-1 gap-x-1 pl-2 pb-5 mx-13.75"
  >
    {
      wtbhPosts.map((help: any) => (
        <Card
          pubDate={help.frontmatter.pubDate}
          postTitle={help.frontmatter.postTitle}
          image={help.frontmatter.image.url}
          alt={help.frontmatter.image.alt}
          url={help.url}
          testItem1={help.frontmatter.testItem1}
          language={help.frontmatter.language}
          backend={help.frontmatter.backend}
        />
      ))
    }
  </div>
  <CTAcontent />
</MainLayout>
