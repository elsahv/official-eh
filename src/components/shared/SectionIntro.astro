---
export interface Props {
  bannerTitle: string;
  bannerParagraph: string;
}

const { bannerTitle, bannerParagraph } = Astro.props as Props;
---

<div id="" class="text-[#403d39] opacity-90 px-5 py-2 my-5 text- bg-">
  <div class="pt-5">
    <h1 class="bg- 2xl:text-3xl md:text-2xl text-3xl pb-2 pt-2 font-bold">
      {bannerTitle}
    </h1>
    <p class="text-md lowercase pl-2">
      {bannerParagraph}
    </p>
  </div>
</div>
