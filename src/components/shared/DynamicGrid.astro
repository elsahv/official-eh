---
interface Item {
  title: string;
  body: string;
  href?: string;
  linkLabel?: string;
}

interface Props {
  items: Item[];
  columns?: 2 | 3 | 4;
  className?: string;
}

const { items, columns = 3, className = "" } = Astro.props as Props;

const gridCols = {
  2: "grid-cols-1 md:grid-cols-2",
  3: "grid-cols-1 md:grid-cols-3",
  4: "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4",
}[columns];
---

<div class:list={["grid grid-cols-1 md:grid-cols-2 gap-6", className]}>
  {
    items.map((item) => (
      <article
        class="flex min-h-55 flex-col
             rounded border border-[#DBA74A] p-5"
      >
        <h3 id="" class="text-3xl text- font-extrabold leading-tight">
          {item.title}
        </h3>

        <p id="sentence" class="mt-3 flex-1 leading-relaxed text-purple-3--">
          {item.body}
        </p>

        {item.href && (
          <a
            href={item.href}
            class="mt-6 inline-block self-start
                 text-xl underline underline-offset-2
                 hover:opacity-70 font-extrabold"
          >
            {item.linkLabel || "Learn more"}
          </a>
        )}
      </article>
    ))
  }
</div>
